<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#08090D">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CARROM X"
        android:textColor="#FFFFFF"
        android:textSize="42sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ONLINE CARROM"
        android:textColor="#8B8F9A"
        android:textSize="14sp"
        android:layout_marginBottom="50dp"/>

    <Button
        android:id="@+id/playOnlineButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="PLAY ONLINE"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/playBotButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="PLAY WITH BOT"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/createRoomButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="CREATE ROOM"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/joinRoomButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:text="JOIN ROOM"/>

</LinearLayout>
